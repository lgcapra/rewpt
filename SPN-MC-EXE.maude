in SPN-EXE
in STATE-TRAN

view System from TRIV to SPN-EXE is
   sort Elt to System .
endv

view Net from TRIV to SPN-EXE is
   sort Elt to Net .
endv

*** this module re-defines the SPN example using the redundant state description used to derive a CTMC
fmod SPN-MC-EXE is
 pr MC-STATE-TRAN{System} .
 pr MATCH-CLASS{System} .
 pr MATCH-CLASS{Net} .
 pr MATCH-CLASS{Pbag{Nat}} * (sort MatchGroup{Pbag{Nat}} to MatchGroup{Pbag}, sort MatchClass{Pbag{Nat}} to MatchClass{Pbag}) .
 pr MATCH-CLASS{Tlab{String}} * (sort MatchGroup{Tlab{String}} to MatchGroup{Tlab}, sort  MatchClass{Tlab{String}} to  MatchClass{Tlab}).
 pr MATCH-CLASS{Tmatrix{Nat}} * (sort MatchGroup{Tmatrix{Nat}} to MatchGroup{Tmatrix}, sort MatchClass{Tmatrix{Nat}} to MatchClass{Tmatrix} ) .

 vars T T' : Tran . vars N N' N'' : Net . vars S S' : System . var XM : Match . 
 var P : Place . vars M  M' : Pbag  . vars R R' R''  : Float . vars L L' : Tlab .
 var Q : Tmatrix . var W : String . var E : Nat . var X : Set{StateTran{System}} .
 *** var Z : Set{StateTran{Net}} .
 *** var Y : Set{StateTran{Pbag}} .
 
  *** encoding of firing rule: same structure for any rule
  *** non optimized version 
  op firing-match : System -> Set{StateTran{System}} [memo] .
  eq firing-match(S) = $firing-match(S, noStateTran) .
  op $firing-match : System Set{StateTran{System}} -> Set{StateTran{System}} .
  ceq $firing-match(S, X) = $firing-match(S,  (XM  --> S' : R)  U X)  if N M := S /\ 
        T ; N' := N  /\ hasConcession(T, M) /\ M' := firing(T, M) /\ not(overCap(M')) /\ 
        S' := N M' /\ R := firingRate(T, M) /\  XM := {N'} & {T} & {M} /\ (XM  --> S' : R) in X = false .
        *** S' := emptyNet M' /\ R := firingRate(T, M) /\  XM := {N'} & {T} & {M} /\ (XM  --> S' : R) in X = false .
  eq $firing-match(S, X) = X [owise] .
 
  *** encoding of rules defined in SPN-EXE-SYS
  *** merge rule (optimized considering that the marking is not affected)
  op merge-match : System -> Set{StateTran{System}} [memo].
  eq merge-match(S) = $merge-match(S, noStateTran) .
  op $merge-match : System Set{StateTran{System}} -> Set{StateTran{System}} .
  *** ceq $merge-match(S, Z) = $merge-match(S, (XM  --> N' : R)  U Z)  if (N ; T ; T') M := S /\ W := tag(T) /\ W = tag(T') /\ E := pol(T) /\
  ***       E = pol(T') /\ hasConcession(T, M) = hasConcession(T', M) /\ N' := N ; merge(T, T', t(W, rate(T) + rate(T'), E))  /\ R := 0.02 /\ XM := {N} & {T , T'} & {M} /\ (XM --> N' : R) in Z = false .
  *** partial optimization: subset of variables used in match, but in we use S in state transitions 
  ceq $merge-match(S, X) = $merge-match(S, (XM  --> S' : R)  U X)  if (N ; T ; T') M := S /\ W := tag(T) /\ W = tag(T') /\ E := pol(T) /\
        E = pol(T') /\ hasConcession(T, M) = hasConcession(T', M) /\ S' := (N ; merge(T, T', t(W, rate(T) + rate(T'), E))) M  /\ R := 0.02 /\ XM := {N} & {T , T'} & {M} /\ (XM --> S' : R) in X = false .
  eq $merge-match(S, X) = X [owise] .
  *** op merge-match : System -> Set{StateTran{System}} [memo]. *** full version (no optiimization)
  *** eq merge-match(S) = $merge-match(S, noStateTran) .
  *** op $merge-match : System Set{StateTran{System}} -> Set{StateTran{System}} .
  *** ceq $merge-match(S, X) = $merge-match(S, (XM  --> S' : R)  U X)  if (N ; T ; T') M := S /\ W := tag(T) /\ W = tag(T') /\ E := pol(T) /\
  ***       E = pol(T') /\ hasConcession(T, M) = hasConcession(T', M) /\ S' := (N ; merge(T, T', t(W, rate(T) + rate(T'), E))) M  /\ R := 0.02 /\ XM := {N} & {T , T'} & {M} /\ (XM --> S' : R) in X = false .
  *** eq $merge-match(S, X) = X [owise] .
  
  *** aggr rule (partially optimized)
  op aggr-match : System -> Set{StateTran{System}} [memo] .
  eq aggr-match(S) = $aggr-match(S, noStateTran) .
  op $aggr-match : System Set{StateTran{System}} -> Set{StateTran{System}} .
  ***ceq $aggr-match(S, Z) = $aggr-match(S,  (XM  --> N' : R)  U Z) if (N ; T ; T')  M := S /\ E := pol(T) /\ E = pol(T') /\ hasConcession(T', M) = false /\
  ***   I := I(q(T')) /\ O := O(q(T)) /\ O = I /\ intersection(support(I),  netPlaces(N) U support(I(q(T)) + H(q(T)) + M + O(q(T')) + H(q(T')))) == emptyPset /\
  ***   R'' := rate(T) /\ R' := rate(T')  /\ N' := N ; aggr(T, T', t(tag(T) + "-" + tag(T'), R'' * R' / (R'' + R'), E)) /\
  ***   R := 0.05 /\ XM := {N} & {T , T'} & {M} /\ (XM  --> N' : R) in Z = false . 
  *** optimization: subset of variables used in match
  ceq $aggr-match(S, X) = $aggr-match(S,  (XM  --> S' : R)  U X) if (N ; T ; T')  M := S /\ E := pol(T) /\ E = pol(T') /\ hasConcession(T', M) = false /\
     O(T) = I(T') /\ intersection(support(I(T')),  netPlaces(N) U support(I(T) + H(T) + M + O(T') + H(T'))) == emptyPset /\
     R'' := rate(T) /\ R' := rate(T')  /\ S' := (N ; aggr(T, T', t(tag(T) + "-" + tag(T'), R'' * R' / (R'' + R'), E))) M /\
     R := 0.05 /\ XM := {N} & {T , T'} & {M} /\ not((XM  --> S' : R) in X) .
  eq $aggr-match(S, X) = X [owise] .
  
  *** fold rule (Net portion)
  op fold-match : System -> Set{StateTran{System}} [memo].
  eq fold-match(S) = $fold-match(S, noStateTran) .
  op $fold-match : System Set{StateTran{System}} -> Set{StateTran{System}} .
  *** ceq $fold-match(S, Z) = $fold-match(S, (XM  --> N' : R)  U Z)  if (N ; L |-> Q ; L' |-> Q) := S  /\ E := pol(L) /\
  ***        E = pol(L') /\ N' := N ; t("fold" ,  rate(L) + rate(L'), E) |-> Q  /\ R := 0.02 /\ XM := {N''} & {L , L'} & {Q} /\ (XM  --> N' : R) in Z = false  .
  ceq $fold-match(S, X) = $fold-match(S, (XM  --> S' : R)  U X)  if (N ; L |-> Q ; L' |-> Q) M := S  /\ E := pol(L) /\
         E = pol(L') /\ S' := (N ; t("fold", rate(L) + rate(L'), E) |-> Q) M  /\ R := 0.02 /\ XM := {L , L'} & {Q} /\ (XM  --> S' : R) in X = false  .
  eq $fold-match(S, X) = X [owise] .

  *** Core operator:passes from the usual SPN representation to the redundant (point out state transitions) used to derive the CTM
  op mcStateTran : System -> McStateTran .
  eq mcStateTran(S) = Src: S Trg: cumrate(firing-match(S) U fold-match(S) U merge-match(S) U aggr-match(S)) .

  *** this part just outlines a potential systematic optimization
endfm

