in ALG-PN.maude

fmod REW-ALG-PN{PL :: TRIV, TL :: TRIV} is
  pr ALG-PN-MARKING{PL} .

  sorts Transition Net System .
  subsort Transition < Net .
  
  op emptyN : -> Net [ctor] .
  op [_]_=>_ : TL$Elt Marking Marking -> Transition [ctor prec 53] .
  op _,_ : Net Net -> Net [ctor assoc comm id: emptyN prec 121] .
  op __ : Net Marking -> System [ctor prec 121] .
  ops pre post : Transition -> Marking .
  op lab : Transition -> TL$Elt .
  
  vars M M' : Marking . vars T T' : Transition . var N : Net . var X : TL$Elt . var P : Place . 
  eq pre([X] M => M') = M .
  eq post([X] M => M') = M' .
  eq lab([X] M => M') = X .
  ceq T, T' = [X] pre(T) ; pre(T') => post(T) ; post(T') if X := lab(T) /\ X = lab(T')  . --- merge transitions with same label (necessary because places may have different types)
endfm

view Substitution from TRIV to META-LEVEL is
  sort Elt to Substitution .
endv

fmod SUBST-SET is
  pr SET{Substitution} * (op empty to NoSubst) .
endfm

--- finds all matches of a term in a module, returning the corresponding substitutions

fmod MATCH-FINDER is
  pr SUBST-SET .
  
  op allMatches : Module Term Term -> Set{Substitution} .
  op $allMatches : Module Term Term Nat -> Set{Substitution} .

  var mod : Module . 
  vars T U :  Term . 
  var X : Nat .
  var SUBST : [Substitution] .
  eq allMatches(mod, T, U) = $allMatches(mod, T, U, 0) .
  ceq $allMatches(mod, T, U, X) = SUBST, $allMatches(mod, T, U, X + 1) 
      if SUBST := metaMatch(mod, T, U, nil, X) /\ SUBST =/= noMatch .
  eq $allMatches(mod, T, U, X) = NoSubst [owise] .
endfm

--- emulates the transition firing in an algebraic net

mod ALG-PN-EMU{PL :: TRIV, TL :: TRIV} is
  pr MATCH-FINDER .
  pr REW-ALG-PN{PL, TL} .
  
  op tranInstances : Module Transition Marking -> Set{Substitution} .
  op errMark : -> [Marking] [ctor] . --- used in downTerm
  op mod : -> Module [memo] . ---alias (lately bounded)
  
  var T : Transition . var N : Net . vars M PRE POST : Marking .
  var I : Substitution .  var S : Set{Substitution} .
  var MOD : Module .
  
  eq tranInstances(MOD, T, M) = allMatches(MOD, '_;_['Mrest:Marking, upTerm(pre(T))], upTerm(M)) .
  --- to make the match work, the right-hand side (pre) must be completed with ... ;  Mrest:Marking (alternatively the rule itself could be completed)
  --- this is because metaXmatch seems to give the same result as metaMatch (need to understand why)
  
  crl [firing] : N, T M => N, T (M ; POST subtr PRE) if I, S := tranInstances(mod, T, M)  /\ 
             PRE  := downTerm(applySubstitution(mod, upTerm(pre(T)), I), errMark) /\ 
             POST := downTerm(applySubstitution(mod, upTerm(post(T)),I), errMark) .
endm

--- example of dining philosophers' algebraic nets (signature)

in PHIL-N

fmod DINING-PHIL is
  pr MARKING{Phil, String} .
  pr REW-ALG-PN{String, String} .

  op th : Mset{Phil} Mset{Phil} Phil -> Transition . --- aliases
  ops e pk  : Mset{Phil} Mset{Phil} Mset{Phil} Nat  -> Transition . --- aliases
  op net : Mset{Phil} Mset{Phil} Mset{Phil} Phil Nat  -> Transition . --- aliases
 
  var Ph : Phil . vars B B' B'' : Mset{Phil} . vars X Y : Nat . var K : NzNat .
  eq th(B, B', Ph)    = ["th"] p("Think") |-> B Ph  ;  p("Pickup") |-> B' => p("Think") |-> B  ;  p("Pickup") |-> B' Ph .
  eq pk(B, B', B'', X) = ["pk"] p("Pickup") |-> B ph(X) ; p("Fork") |-> B' ph(X) ph(s(X)) ; p("Eat") |-> B''  =>  
            p("Pickup") |-> B ; p("Fork") |-> B' ; p("Eat") |-> B'' ph(X) .
  eq e(B, B', B'', X) = ["e"]  p("Eat") |-> B ph(X) ; p("Fork") |-> B'  ; p("Think") |-> B''  =>  
         p("Eat") |-> B ; p("Fork") |-> B' ph(X) ph(s(X)) ; p("Think") |-> B'' ph(X) .
  eq net(B, B', B'', Ph, X) = th(B, B', Ph) , pk(B, B', B'', X), e(B, B', B'', X) .

  op nphil : Nat -> Mset{Phil} [memo] . *** defined for convenience
  eq nphil(0) = empty{Phil} .
  eq nphil(K) = ph(sd(K,1)) nphil(sd(K,1)) .
  op m0 : -> Marking . 
  eq m0 =  p("Think") |-> nphil(N) ; p("Fork") |-> nphil(N) ; p("Eat") |-> empty{Phil} ; p("Pickup") |-> empty{Phil} .
  
endfm

mod DINING-PHIL-EMU is
  inc ALG-PN-EMU{String, String} .
  inc DINING-PHIL .
  eq mod = upModule('DINING-PHIL, false) . --- alias for the module
  --- example of Net rewrite
  crl N:Net, T:Transition => N:Net if lab(T:Transition) = "th" .
endm

search in DINING-PHIL-EMU : net(B:Mset{Phil}, B':Mset{Phil}, B'':Mset{Phil}, Ph:Phil, X:Nat) m0 =>! S:System .
