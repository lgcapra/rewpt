--- Trying to use the meta-level to represent changes in the net
--- Transitions in the net are "simple" rewrite rules (on markings)
--- This  avoids the need of variables in the representation of transitions
--- Operations on the net are operations on the rewrite theory (using the meta-level
--- to add, remove or modify rewrite rules). 

--- A state takes a module and a marking : MOD @ MARK
--- The module should contain the rules representing the transitions 
in DINING-PHIL

mod STATE{X :: TRIV} is
 pr APN-MARKING{X} .
 pr META-LEVEL .
 sort State .
 op _@_ : Module Marking -> State [ctor frozen] .
 op error : -> Marking [ctor] .

 --- Boxed marking (needed to avoid renamings) 
 sort BMarking .
 op [_] : Marking -> BMarking [ctor] .
endm


view BMarking{X :: TRIV} from TRIV to STATE{X} is
  sort Elt to BMarking .
endv


mod SEMANTICS{X :: TRIV} is
 pr SET{BMarking{X}} * (sort Set{BMarking{X}} to SBMarking) .

 --- ------------------------------
 vars PRE POST  M M' : Marking .
 var MOD : Module .
 var TERM : Term .
 var STATE : State .
 var RES? : ResultTriple? .
 var RESP? : ResultPair? .
 var N : Nat .
 var SBMAR : SBMarking .
 var RS : RuleSet .
 var Q : Qid .
 vars T T' : Term .
 vars ATTS : AttrSet .
 vars COND COND' : Condition .
 --- ------------------------------


 --- Successor states
 op next : State -> SBMarking .
 op next : State Nat -> SBMarking .
 eq next(STATE) = next(STATE, 0) .

 ceq next(MOD @ M, N) = 
  if RES? == failure
  then empty
  else [downTerm(getTerm(RES?), error)], next(MOD @ M, s(N))
  fi 
 if RES? := metaSearch(MOD, upTerm(M), 'M:Marking, nil, '+, 1, N) .

 --- Only one rule needed to move to the next state
 crl [step] : MOD @ M => MOD @ M'
  if [M'], SBMAR := next(MOD @ M) .

 --- Possible operations in the net, e.g., adding transitions. 
 --- Adding a rule to a theory
  --- Adds to M the rules Rls
 op addRls : Module RuleSet -> Module .
 eq addRls(MOD, RS)
   = (mod 'NEW-MOD is
   getImports(MOD)
 sorts getSorts(MOD) .
 getSubsorts(MOD) getOps(MOD)
 getMbs(MOD) getEqs(MOD)
   (getRls(MOD) RS) endm ) .

  --- Checking if a rule with a given label is in the module 
  op in : Qid Module  -> Bool .
  op in : Qid RuleSet  -> Bool .
  eq in(Q, MOD) = in(Q, getRls(MOD)) .
  eq in(Q, RS (rl T => T' [ ATTS  label(Q) ].)) = true .
  eq in(Q, RS (crl T => T' if COND  [ ATTS  label(Q) ].)) = true .
  eq in(Q, RS) = false [owise] .

   --- Removing a rule from the module 
  op remove : Qid Module  -> Module .
  eq remove(Q, MOD) = 
     (mod 'NEW-MOD is
       getImports(MOD)
       sorts getSorts(MOD) .
       getSubsorts(MOD) getOps(MOD)
       getMbs(MOD) getEqs(MOD)
       (remove(Q, getRls(MOD))) 
      endm ) .
  op remove : Qid RuleSet  -> RuleSet .
  eq remove(Q, RS (rl T => T' [ ATTS  label(Q) ].)) = none .
  eq remove(Q, RS (crl T => T' if COND  [ ATTS  label(Q) ].)) = none .
  eq remove(Q, RS) = RS [owise] .

  --- Checking if a rule with a given label is firable 
  --- This can be also implemented with metaApply (?)
  op firable? : Qid Module Marking -> Bool .
  ceq firable?(Q, MOD, M) =
      RESP? =/= failure 
   if RESP? := metaSrewrite(MOD, upTerm(M), Q [ none ] {empty}, breadthFirst, 0) .

 --- Updating the guard of a rule
 op update : Qid Module Condition -> Module .
 eq update(Q, MOD, COND) = 
     (mod 'NEW-MOD is
       getImports(MOD)
       sorts getSorts(MOD) .
       getSubsorts(MOD) getOps(MOD)
       getMbs(MOD) getEqs(MOD)
       (update(Q, getRls(MOD), COND)) 
      endm ) .
 op update : Qid RuleSet Condition  -> RuleSet .
 eq update(Q, RS (crl T => T' if COND  [ ATTS  label(Q) ].), COND') = 
              RS (crl T => T' if COND'  [ ATTS  label(Q) ].) .
 eq update(Q, RS, COND) = RS [owise] .

endm

mod EXAMPLE is
 ex SEMANTICS{String} .
 pr DINING-PHIL-MARK .

 op init  : -> State .

 vars MOD MOD' : Module .
 vars M  M' : Marking .
 vars BP BT : Mset{Phil} .

 eq init = upModule('EXAMPLE, false)  @ m0(5) .

 inc MARKING{Phil, String} .
 var Ph : Phil . vars B B' B'' : Mset{Phil} . var X : Nat . var K : NzNat .
 crl [th] : p("Think") |-> B Ph  ;  p("Pickup") |-> B' => p("Think") |-> B  ;  p("Pickup") |-> B' Ph 
     if true . --- Dummy condition seems "update" looks for crl only 
 rl [pk] : p("Pickup") |-> B ph(X, K) ; p("Fork") |-> B' ph(X, K) ph(s(X), K) ; p("Eat") |-> B''  =>  
           p("Pickup") |-> B ; p("Fork") |-> B' ; p("Eat") |-> B'' ph(X, K) .
 rl [e] : p("Eat") |-> B ph(X, K) ; p("Fork") |-> B'  ; p("Think") |-> B''  =>  
          p("Eat") |-> B ; p("Fork") |-> B' ph(X, K) ph(s(X), K) ; p("Think") |-> B'' ph(X, K) . 

 crl [change] : MOD @ M  => MOD' @ M 
 if firable?('th, MOD, M) /\
    M' ; p("Pickup") |-> BP ; p("Think") |-> BT := M /\ --- Just extracting the needed markings
    MOD' := update('th, MOD, '_>_[upTerm(len(BT)),  upTerm(len(BP))] = 'true.Bool) .
endm


eof 


red init .
rew [1] init .

--- 120 solutions (without adding any rule)
search init =>* S:State .
--- 1396 solutions if rule change is added
search init =>* S:State .

--- The original rewrite rules
--- Note the guard of rule th: if 'true.Bool = 'true.Bool [label('th)] .
red init .
--- Once change is applied, the guard of this rule changes
--- if '_>_['s_^5['0.Zero], '0.Zero] = 'true.Bool
srew init using change .


--- Using strategies
--- Do not reconfigure (then 120 solution)
srew init using step * .

--- Do the reconfiguration anytime (if possible)
srew init using (step | change) * .

--- Do the reconfiguration only if a step is not possible
srew init using (step or-else change) * .


--- Reconfigure if possible and then step
srew init using (try(change) ; step ) * .

